spring.datasource.url=jdbc:postgresql://localhost:5432/soportenet_isp
spring.datasource.username=postgres
spring.datasource.password=tu_password_aqui
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

server.port=8080

# Clave para firmar los JWT de sesion. Genera la tuya propia, no reutilices
# ninguna clave que hayas visto en el chat del proyecto. Una forma facil:
# en una terminal (Git Bash) corre: openssl rand -base64 48
app.jwt.secret=cambia_esto_por_tu_propia_clave_aleatoria
app.jwt.expiration-minutes=120

# Carpeta donde se guardan los adjuntos (evidencia) subidos a las
# solicitudes. Se crea sola si no existe.
app.storage.adjuntos-dir=./uploads/adjuntos

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Correo: usa una cuenta de Gmail + "contrasena de aplicacion" (no tu
# contrasena normal - se genera en la config de seguridad de tu cuenta Google).
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tu_correo_aqui@gmail.com
spring.mail.password=tu_contrasena_de_aplicacion
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.frontend.url=http://127.0.0.1:5500/frontend/views
